; Farsi (Persian) messages for the EasyWalp installer.
; Partial translation: any message not listed here falls back to Default.isl
; (English), which is the standard Inno Setup behaviour for custom languages.
; Put this file beside easywalp.iss (or in Inno's Languages folder).

[LangOptions]
LanguageName=فارسی
LanguageID=$0429
LanguageCodePage=0
; RTL dialog mirroring for Persian
DialogFontName=Vazirmatn
DialogFontSize=9
WelcomeFontName=Vazirmatn
WelcomeFontSize=12

[Messages]
; Buttons and wizard pages
ButtonBack=< قبلی
ButtonNext=بعدی >
ButtonInstall=نصب
ButtonOK=تأیید
ButtonCancel=لغو
ButtonYes=بله
ButtonYesToAll=بله به همه
ButtonNo=خیر
ButtonNoToAll=خیر به هیچ‌کدام
ButtonFinish=پایان
ButtonBrowse...=مرور...
ButtonWizardBrowse=مرور...
ButtonNewFolder=پوشه جدید
; Wizard pages
SetupWindowTitle=نصب EasyWalp
WelcomeLabel1=به نصب EasyWalp خوش آمدید
WelcomeLabel2=این برنامه EasyWalp را روی رایانه شما نصب می‌کند. توصیه می‌شود همه برنامه‌های باز را ببندید و ادامه دهید.
SelectDirDesc=کجا نصب شود؟
SelectDirLabel3=نصب، EasyWalp را در پوشه زیر قرار می‌دهد.
SelectDirBrowseLabel=برای ادامه، روی «بعدی» کلیک کنید. اگر پوشه دیگری می‌خواهید، روی «مرور...» کلیک کنید.
SelectProgramGroupDesc=پوشه منوی شروع
SelectTasksDesc=کارهای اضافی
ReadyLabel1=برای نصب آماده‌اید.
InstallingLabel=لطفاً صبر کنید، در حال نصب EasyWalp...
FinishedHeadingLabel=نصب EasyWalp کامل شد
FinishedLabelNoIcons=EasyWalp روی رایانه شما نصب شد.
FinishedLabel=EasyWalp روی رایانه شما نصب شد.[nl][nl]برای اجرا، روی «پایان» کلیک کنید.
ExitSetupTitle=خروج از نصب
ExitSetupMessage=نصب کامل نشده است. اگر همین حالا خارج شوید، برنامه نصب نخواهد شد.[nl][nl]می‌توانید بعداً دوباره نصب را اجرا کنید.[nl][nl]خروج از نصب؟
; Standard messages
NextButtonCaption=&بعدی
InstallButtonCaption=&نصب
UninstallAppName=%1 را حذف کنید
UninstallAppFullTitle=حذف %1
UninstallStatusLabel=لطفاً صبر کنید، در حال حذف EasyWalp...
